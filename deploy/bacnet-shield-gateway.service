# systemd unit — bacnet-shield gateway instance (retrofit box).
# Install: cp deploy/bacnet-shield-gateway.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now bacnet-shield-gateway
#
# The gateway protects one or more legacy BACnet/IP devices. Each `devices:`
# entry in the config is an independent listener<->device pair: the proxy
# multiplexes that pair's clients onto its own device-leg socket and enforces
# that device's allow-list, per-client rate limit and write policy. No traffic
# crosses between co-hosted devices. Config from
# /etc/bacnet-shield/gateway.yaml (see configs/gateway.yaml). The device-side
# wire stays plain BACnet/IP.

[Unit]
Description=BACnet/IP retrofit security proxy (gateway)
Documentation=https://github.com/GalaxyGorilla/bacnet-shield
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WatchdogSec=30
# READY=1 + WATCHDOG=1 pings are sent by the binary (internal/watchdog).
ExecStart=/usr/local/bin/bacnet-shield gateway --config /etc/bacnet-shield/gateway.yaml
# SIGHUP re-reads the config and swaps the access policy in place (no
# dropped clients). Listener/device/timeout changes need a restart and are
# logged as warnings: `systemctl reload bacnet-shield-gateway`.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

ConfigurationDirectory=bacnet-shield

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX is required for sd_notify (Type=notify / WatchdogSec above): a
# RestrictAddressFamilies list without it makes READY=1 fail with
# EAFNOSUPPORT and systemd reports a start timeout.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

# 47808 is above 1024, so no capability is needed to bind it. If you run the
# client leg on a privileged port, add CAP_NET_BIND_SERVICE here.
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

User=bacnet-shield
Group=bacnet-shield

[Install]
WantedBy=multi-user.target
